Configs: {
	DrawbridgeConfig: {
		DisplayName: Configuração da Ponte Levadiça

		DisableEasterEgg: {
			Label: Desativar Easter Egg
			Tooltip: ""
		}

		MuteClockSound: {
			Label: Silenciar Som do Relógio
			Tooltip: Se ativado, o relógio não tocará seu som horário.
		}

		MuteStableNoises: {
			Label: Silenciar Sons do Estábulo
			Tooltip: Se ativado, estábulos de cavalos não farão seus sons.
		}

		DisableHorseStablePooping: {
			Label: Desativar Cocô no Estábulo
			Tooltip: Se ativado, cavalos nos estábulos não soltarão cocô.
		}
	}
}

