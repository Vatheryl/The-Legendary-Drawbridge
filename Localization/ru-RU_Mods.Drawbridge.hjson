Configs: {
	DrawbridgeConfig: {
		DisplayName: Конфигурация разводного моста

		DisableEasterEgg: {
			Label: Отключить пасхалку
			Tooltip: ""
		}

		MuteClockSound: {
			Label: Отключить звук часов
			Tooltip: Если включено, часы не будут издавать звуки каждый час.
		}

		MuteStableNoises: {
			Label: Отключить звуки конюшни
			Tooltip: Если включено, конюшни не будут издавать звуки.
		}

		DisableHorseStablePooping: {
			Label: Отключить помет в конюшне
			Tooltip: Если включено, лошади в конюшнях не будут оставлять помет.
		}
	}
}

