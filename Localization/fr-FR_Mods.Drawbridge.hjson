Configs: {
	DrawbridgeConfig: {
		DisplayName: Configuration du Pont-levis

		DisableEasterEgg: {
			Label: Désactiver l'Easter Egg
			Tooltip: ""
		}

		MuteClockSound: {
			Label: Couper le Son de l'Horloge
			Tooltip: Si activé, l'horloge ne jouera pas son son horaire.
		}

		MuteStableNoises: {
			Label: Couper les Bruits de l'Écurie
			Tooltip: Si activé, les écuries ne feront pas de bruit.
		}

		DisableHorseStablePooping: {
			Label: Désactiver le Crottin dans l'Écurie
			Tooltip: Si activé, les chevaux dans les écuries ne feront pas de crottin.
		}
	}
}

