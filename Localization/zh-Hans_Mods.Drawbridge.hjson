Configs: {
	DrawbridgeConfig: {
		DisplayName: 吊桥配置

		DisableEasterEgg: {
			Label: 禁用彩蛋
			Tooltip: ""
		}

		MuteClockSound: {
			Label: 静音时钟声音
			Tooltip: 启用后，时钟将不会播放整点声音。
		}

		MuteStableNoises: {
			Label: 静音马厩噪音
			Tooltip: 启用后，马厩不会发出声音。
		}

		DisableHorseStablePooping: {
			Label: 禁用马厩掉粪
			Tooltip: 启用后，马厩中的马不会掉粪。
		}
	}
}

