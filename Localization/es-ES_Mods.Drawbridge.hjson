Configs: {
	DrawbridgeConfig: {
		DisplayName: Configuración del Puente Levadizo

		DisableEasterEgg: {
			Label: Desactivar Easter Egg
			Tooltip: ""
		}

		MuteClockSound: {
			Label: Silenciar Sonido del Reloj
			Tooltip: Si está activado, el reloj no reproducirá su sonido cada hora.
		}

		MuteStableNoises: {
			Label: Silenciar Ruidos del Establo
			Tooltip: Si está activado, los establos no harán ruidos.
		}

		DisableHorseStablePooping: {
			Label: Desactivar Caca en el Establo
			Tooltip: Si está activado, los caballos en los establos no dejarán caca.
		}
	}
}

