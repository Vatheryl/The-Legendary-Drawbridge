Configs: {
	DrawbridgeConfig: {
		DisplayName: Configurazione Ponte Levatoio

		DisableEasterEgg: {
			Label: Disattiva Easter Egg
			Tooltip: ""
		}

		MuteClockSound: {
			Label: Disattiva Suono Orologio
			Tooltip: Se abilitato, l'orologio non suonerà ogni ora.
		}

		MuteStableNoises: {
			Label: Disattiva Rumori della Stalla
			Tooltip: Se abilitato, le stalle non faranno rumore.
		}

		DisableHorseStablePooping: {
			Label: Disattiva Cacca nella Stalla
			Tooltip: Se abilitato, i cavalli nelle stalle non lasceranno cacca.
		}
	}
}

