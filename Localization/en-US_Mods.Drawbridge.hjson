	GoldenResonance: {
		DisplayName: Golden Resonance
		Description: Grants increased life regeneration and movement speed.
	}

	SpiritVeil: {
		DisplayName: Spirit Veil
		Description: Grants defense at night or in graveyards, and immunity to Cursed and Darkness.
	}

