Configs: {
	DrawbridgeConfig: {
		DisplayName: Zugbrücken-Konfiguration

		DisableEasterEgg: {
			Label: Easter Egg deaktivieren
			Tooltip: ""
		}

		MuteClockSound: {
			Label: Uhrensound stummschalten
			Tooltip: Wenn aktiviert, spielt die Uhr keinen Stundenton ab.
		}

		MuteStableNoises: {
			Label: Stallgeräusche stummschalten
			Tooltip: Wenn aktiviert, machen die Ställe keine Geräusche.
		}

		DisableHorseStablePooping: {
			Label: Pferdekot im Stall deaktivieren
			Tooltip: Wenn aktiviert, hinterlassen Pferde im Stall keinen Kot.
		}

		PortcullisSpeed: {
			// Label: Portcullis Speed
			// Tooltip: Controls how quickly Portcullis tiles raise/lower. The higher, the faster.
		}

		SlotPosition: {
			// Label: Horse Armor Slot Position
			// Tooltip: Allows customization to where the horse armor slot is placed, in case of cross-mod overlap.
		}
	}

	HorseMountSlotPosition: {
		// Tooltip: ""

		Default: {
			// Label: Default
			// Tooltip: Default slot position: to the right of the vanilla mount slot.
		}

		DownOne: {
			// Label: Down
			// Tooltip: One slot under the default slot position: to the right of the vanilla hook slot.
		}

		NextToBuffs: {
			// Label: Buffs
			// Tooltip: To the left of the vertical buff icon display: under the vanilla hook dye slot.
		}

		LeftOfTop: {
			// Label: Top-Left
			// Tooltip: To the left of the topmost misc equip: to the left of the vanilla pet dye slot.
		}

		LeftOfBottom: {
			// Label: Bottom-Left
			// Tooltip: To the left of the bottom-most misc equip: to the left of the vanilla hook dye slot.
		}
	}
}

