Configs: {
	DrawbridgeConfig: {
		DisplayName: Konfiguracja Mostu Zwodzonego

		DisableEasterEgg: {
			Label: Wyłącz Easter Egg
			Tooltip: ""
		}

		MuteClockSound: {
			Label: Wycisz Dźwięk Zegara
			Tooltip: Jeśli włączone, zegar nie będzie odtwarzał dźwięku o pełnej godzinie.
		}

		MuteStableNoises: {
			Label: Wycisz Dźwięki Stajni
			Tooltip: Jeśli włączone, stajnie nie będą wydawać dźwięków.
		}

		DisableHorseStablePooping: {
			Label: Wyłącz Kupa w Stajni
			Tooltip: Jeśli włączone, konie w stajniach nie będą zostawiać kupy.
		}
	}
}

